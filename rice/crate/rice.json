        "animations": true,
        "activeOpacity": 1,
        "inactiveOpacity": 1,
        "borderFollowsPalette": false,
        "activeBorder": "#06b6d4",
        "inactiveBorder": "#212226",
        "borderSize": 1,
        "gapsIn": 10,
        "gapsOut": 18,
        "rounding": 6,
        "roundingPower": 2,
        "blurEnabled": true,
        "shadowEnabled": false,
        "wobblyWindows": false
      }
    },
    "shell": {
      "barStyle": "qsbar",
      "fontFamily": "JetBrainsMono Nerd Font",
      "theme": {
        "attributes": {
          "font": {
            "primary": "",
            "secondary": "",
            "tertiary": ""
