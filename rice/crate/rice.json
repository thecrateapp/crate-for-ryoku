{
  "schema": 1,
  "slug": "crate",
  "name": "Crate",
  "author": "crate",
  "blurb": "Crate v3 palette on Ryoku's QS Bar: near-black paper, hairline structure, cyan only where something is active.",
  "tags": [
    "dark",
    "minimal",
    "hud",
    "cyan"
  ],
  "createdWith": "1.0.7",
