#!/usr/bin/env python3
"""Read raw MPRIS positions on one session-bus connection while a panel is open."""

import json
import sys

from gi.repository import Gio, GLib


def main():
    bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
    for line in sys.stdin:
        serial, player = json.loads(line)
        seconds = None
        try:
            result = bus.call_sync(
                player, "/org/mpris/MediaPlayer2", "org.freedesktop.DBus.Properties",
                "Get", GLib.Variant("(ss)", ("org.mpris.MediaPlayer2.Player", "Position")),
                GLib.VariantType("(v)"), Gio.DBusCallFlags.NO_AUTO_START, 750, None,
            )
            value = result.get_child_value(0).get_variant()
            if value.is_of_type(GLib.VariantType("x")):
                seconds = value.get_int64() / 1_000_000
        except GLib.Error:
            pass
        print(json.dumps([serial, seconds]), flush=True)


if __name__ == "__main__":
    main()
