{
  "name": "example",
  "output": "example.mkv",
  "surfaces": {
    "hub-widgets": {
      "open": ["ryoku-shell", "hub", "open", "widgets"],
      "close": ["hyprctl", "dispatch", "closewindow", "class:ryoku-hub"]
    }
  },
  "steps": [
    { "at": 0, "do": "play", "action": "play" },
    { "at": 1.5, "do": "notify", "title": "Crate", "body": "Now playing" },
    { "at": 3, "do": "surface", "name": "hub-widgets", "action": "open" },
    { "at": 6, "do": "surface", "name": "hub-widgets", "action": "close" },
    { "at": 7, "do": "cue", "message": "Open Controls with Super+Esc, then press Enter" },
    { "at": 9, "do": "wait" }
  ]
}
