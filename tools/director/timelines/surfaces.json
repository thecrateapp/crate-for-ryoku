{
  "name": "surfaces",
  "output": "surfaces.mkv",
  "surfaces": {
    "launcher": {
      "open": [
        "hyprctl",
        "dispatch",
        "hl.dsp.global(\"ryoku:launcher\")"
      ],
      "close": [
        "wtype",
        "-k",
        "Escape"
      ]
    },
    "controls": {
      "open": [
        "hyprctl",
        "dispatch",
        "hl.dsp.global(\"ryoku:quicksettings\")"
      ],
      "close": [
        "wtype",
        "-k",
        "Escape"
      ]
    },
    "gamebar": {
      "open": [
        "hyprctl",
        "dispatch",
        "hl.dsp.global(\"ryoku:gamebar\")"
      ],
      "close": [
        "hyprctl",
        "dispatch",
        "hl.dsp.global(\"ryoku:gamebar\")"
      ]
    },
    "wallpaper-picker": {
      "open": [
        "qs",
        "-c",
        "shell",
        "ipc",
        "call",
        "picker",
        "wallpaper"
      ],
      "close": [
        "wtype",
        "-k",
        "Escape"
      ]
    },
    "kit": {
      "open": [
        "ryoku-kit"
      ],
      "close": [
        "wtype",
        "-k",
        "Escape"
      ]
    }
  },
  "steps": [
    {
      "at": 0,
      "do": "pointer",
      "to": [
        2560,
        2160
      ]
    },
    {
      "at": 0.2,
      "do": "play",
      "action": "play"
    },
    {
      "at": 1,
      "do": "cue",
      "message": "qsbar: click the crate-mark pill, change the EQ preset, click it closed"
    },
    {
      "at": 7,
      "do": "surface",
      "name": "controls",
      "action": "open"
    },
    {
      "at": 12,
      "do": "surface",
      "name": "controls",
      "action": "close"
    },
    {
      "at": 13,
      "do": "surface",
      "name": "launcher",
      "action": "open"
    },
    {
      "at": 18,
      "do": "surface",
      "name": "launcher",
      "action": "close"
    },
    {
      "at": 19,
      "do": "surface",
      "name": "gamebar",
      "action": "open"
    },
    {
      "at": 24,
      "do": "surface",
      "name": "gamebar",
      "action": "close"
    },
    {
      "at": 25,
      "do": "surface",
      "name": "kit",
      "action": "open"
    },
    {
      "at": 30,
      "do": "surface",
      "name": "kit",
      "action": "close"
    },
    {
      "at": 31,
      "do": "surface",
      "name": "wallpaper-picker",
      "action": "open"
    },
    {
      "at": 36,
      "do": "surface",
      "name": "wallpaper-picker",
      "action": "close"
    },
    {
      "at": 37,
      "do": "cue",
      "message": "dock: move the pointer along the dock and back"
    },
    {
      "at": 43,
      "do": "notify",
      "title": "Crate",
      "body": "Now playing"
    },
    {
      "at": 44.5,
      "do": "notify",
      "title": "Crate",
      "body": "Added to your library"
    },
    {
      "at": 49,
      "do": "wait"
    }
  ]
}
