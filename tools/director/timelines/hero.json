{
  "name": "hero",
  "output": "hero.mkv",
  "surfaces": {
    "launcher": {
      "open": [
        "hyprctl",
        "dispatch",
        "hl.dsp.global(\"ryoku:launcher\")"
      ],
      "close": [
        "wtype",
        "-k",
        "Escape"
      ]
    },
    "controls": {
      "open": [
        "hyprctl",
        "dispatch",
        "hl.dsp.global(\"ryoku:quicksettings\")"
      ],
      "close": [
        "wtype",
        "-k",
        "Escape"
      ]
    },
    "gamebar": {
      "open": [
        "hyprctl",
        "dispatch",
        "hl.dsp.global(\"ryoku:gamebar\")"
      ],
      "close": [
        "hyprctl",
        "dispatch",
        "hl.dsp.global(\"ryoku:gamebar\")"
      ]
    },
    "wallpaper-picker": {
      "open": [
        "qs",
        "-c",
        "shell",
        "ipc",
        "call",
        "picker",
        "wallpaper"
      ],
      "close": [
        "wtype",
        "-k",
        "Escape"
      ]
    },
    "kit": {
      "open": [
        "ryoku-kit"
      ],
      "close": [
        "wtype",
        "-k",
        "Escape"
      ]
    }
  },
  "steps": [
    {
      "at": 0,
      "do": "pointer",
      "to": [
        2560,
        2160
      ]
    },
    {
      "at": 0.2,
      "do": "play",
      "action": "play"
    },
    {
      "at": 4,
      "do": "cue",
      "message": "H2: click the crate-mark pill on the QS Bar"
    },
    {
      "at": 10,
      "do": "cue",
      "message": "H3: click the pill again to close the panel"
    },
    {
      "at": 12,
      "do": "notify",
      "title": "Crate",
      "body": "Now playing"
    },
    {
      "at": 17,
      "do": "surface",
      "name": "launcher",
      "action": "open"
    },
    {
      "at": 23,
      "do": "surface",
      "name": "launcher",
      "action": "close"
    },
    {
      "at": 24,
      "do": "surface",
      "name": "controls",
      "action": "open"
    },
    {
      "at": 29,
      "do": "surface",
      "name": "controls",
      "action": "close"
    },
    {
      "at": 30,
      "do": "cue",
      "message": "H7: drift the pointer over two dock icons and back"
    },
    {
      "at": 36,
      "do": "wait"
    }
  ]
}
