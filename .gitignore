# Built and rendered output, regenerated from the sources here:
#   dist/                      package/build.sh
#   icons/crate-icons/         icons/build_icons.py (run by package/build.sh)
#   wallpaper renders          wallpaper/groove.py, sheen.py (via render.sh)
#   captures/                  review screenshots, some of a live desktop
dist/
captures/
icons/crate-icons/
wallpaper/*.png
wallpaper/webp/
wallpaper/series/
__pycache__/
build/
.superpowers/

# Screencast takes recorded by tools/director
tools/director/takes/

# app themes: signing keys never live here; Chrome and web-ext leave these behind
*.pem
Cached Theme.pak
web-ext-artifacts/

# Lock-screen assets built by lockscreen/build-assets.sh
lockscreen/crate/common/fonts/
lockscreen/crate/common/backgrounds/

# Lock-screen preview shots (lockscreen/preview.sh --shot)
lockscreen/shots/
