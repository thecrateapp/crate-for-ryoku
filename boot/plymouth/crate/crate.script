# Crate for Ryoku: the Crate boot splash.
# Pure black, like the framebuffer before it and the greeter after it, so no
# rectangle seam shows; the Crate mark centred; under it a hairline track whose
# cyan fill follows the boot progress (the kit's Beam) and never moves back.
# A bullet prompt is kept for encrypted disks.

Window.SetBackgroundTopColor(0.0, 0.0, 0.0);
Window.SetBackgroundBottomColor(0.0, 0.0, 0.0);

global.beam_width = 240;

mark.image = Image("mark.png");
mark.sprite = Sprite(mark.image);
mark.x = Window.GetX() + Window.GetWidth() / 2 - mark.image.GetWidth() / 2;
mark.y = Window.GetY() + Window.GetHeight() / 2 - mark.image.GetHeight() / 2 - 24;
mark.sprite.SetPosition(mark.x, mark.y, 1);

beam.x = Window.GetX() + Window.GetWidth() / 2 - global.beam_width / 2;
beam.y = mark.y + mark.image.GetHeight() + 48;
track.image = Image("beam-track.png").Scale(global.beam_width, 1);
track.sprite = Sprite(track.image);
track.sprite.SetPosition(beam.x, beam.y, 1);

fill.base = Image("beam-fill.png");
fill.sprite = Sprite();
fill.sprite.SetPosition(beam.x, beam.y - 1, 2);
global.shown = 0;

fun progress_callback (duration, progress) {
  if (progress > global.shown) {
    global.shown = progress;
    width = Math.Int(global.beam_width * progress);
    if (width < 1) width = 1;
    fill.sprite.SetImage(fill.base.Scale(width, 2));
  }
}
Plymouth.SetBootProgressFunction(progress_callback);

# ---------- password prompt (encrypted disks) ----------
entry.image = Image("entry.png");
entry.sprite = Sprite();
entry.x = Window.GetX() + Window.GetWidth() / 2 - entry.image.GetWidth() / 2;
entry.y = beam.y + 40;
entry.sprite.SetPosition(entry.x, entry.y, 3);
bullet.image = Image("bullet.png");

fun display_password_callback (prompt, bullets) {
  entry.sprite.SetImage(entry.image);
  entry.sprite.SetOpacity(1);
  for (i = 0; bullet.sprites[i] || i < bullets; i++) {
    if (!bullet.sprites[i]) {
      bullet.sprites[i] = Sprite(bullet.image);
      bullet.sprites[i].SetPosition(entry.x + 14 + i * (bullet.image.GetWidth() + 6),
                                    entry.y + entry.image.GetHeight() / 2 - bullet.image.GetHeight() / 2, 4);
    }
    if (i < bullets) bullet.sprites[i].SetOpacity(1);
    else bullet.sprites[i].SetOpacity(0);
  }
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun display_normal_callback () {
  entry.sprite.SetOpacity(0);
  for (i = 0; bullet.sprites[i]; i++) bullet.sprites[i].SetOpacity(0);
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);

fun message_callback (text) {
  # the boot log stays behind Esc; the splash shows no text
}
Plymouth.SetMessageFunction(message_callback);

fun quit_callback () {
  mark.sprite.SetOpacity(0);
  track.sprite.SetOpacity(0);
  fill.sprite.SetOpacity(0);
  display_normal_callback();
}
Plymouth.SetQuitFunction(quit_callback);
